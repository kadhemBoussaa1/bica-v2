# Build context for Dockerfile.prod. Everything the images need is rebuilt
# inside the build, so local build output never goes in; neither do secrets.

.git
**/node_modules
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo
apps/api/src/generated

# Secrets. The examples hold none.
**/.env
**/.env.*
# A literal path, never a wildcard: with a `!**/...` exception BuildKit has
# to walk into every excluded directory in case it holds a match, and
# docker/certbot/conf/accounts is root-only once certbot has run, so a
# `deploy.sh --build` after --ssl-init dies with "permission denied".
!apps/api/.env.example

# Working notes, local tooling, server state.
docs
.claude
.github
.deploy-history
docker/certbot
docker/nginx/state
backups
*.dump
