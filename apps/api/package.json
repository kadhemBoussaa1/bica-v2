{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node dist/seed.js",
    "db:audit:purge": "node dist/audit/purge.js",
    "db:notifications:purge": "node dist/notification/purge.js",
    "db:import:step1": "node dist/migrate/import-clients-suppliers.js",
    "db:import:step2": "node dist/migrate/import-machines-employees.js",
    "db:import:step3": "node dist/migrate/import-orders.js",
    "db:import:step4": "node dist/migrate/import-stock.js",
    "db:import:step5": "node dist/migrate/import-invoices.js",
    "db:import:step6": "node dist/migrate/import-purchasing.js",
    "db:verify-pricing": "node dist/migrate/verify-pricing.js",
    "db:backfill-metrage": "node dist/migrate/backfill-metrage.js",
    "db:employee-accounts": "node dist/migrate/create-employee-accounts.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@repo/api-contract": "workspace:*",
    "@trpc/server": "11.18.0",
    "better-auth": "1.7.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "react": "^19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "eslint": "10.9.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  }
}
