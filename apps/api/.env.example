# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres on 5432)
DATABASE_URL="postgresql://bica:bica_dev_password@localhost:5433/bica?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3001"

# Seeded super admin (the only way one is created)
SUPER_ADMIN_EMAIL="admin@bica.local"
SUPER_ADMIN_PASSWORD="change-this-password-now"
SUPER_ADMIN_NAME="Super Admin"

# S3 assets — the bucket the legacy app uploads to (docs/s3-assets-plan.md).
# Reads need no credentials (anonymous GetObject works), so leave the key pair
# unset unless you need uploads: the API boots either way and only the upload
# procedures fail, with PRECONDITION_FAILED.
AWS_REGION="us-east-2"
AWS_S3_BUCKET="sip-api-assets"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Web Push — phone notifications with the app closed (docs/pwa-plan.md).
# Optional, like the S3 keys: leave all three empty and the API boots with
# push off, and the bell hides its "Notifications on this device" row.
# Generate a pair with: pnpm --filter api exec web-push generate-vapid-keys
# VAPID_SUBJECT is a contact the push services can reach: mailto:… or https://…
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Email notifications (docs/email-notifications-plan.md): the old app's
# eight emails, through its Gmail account. Optional, like push: leave
# SMTP_HOST / SMTP_USER / SMTP_PASSWORD empty and the API boots with mail off
# and logs each email it would have sent instead. Gmail wants an app
# password (not the account's), port 587 with STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="BICA-PACK - Système de Gestion"
# The two fixed recipients of the old app; admins' account emails are added
# to them. Either may be empty.
MAIL_TO_BOSS=""
MAIL_TO_CREATIONS=""

# Legacy bicapack database, for one-off data migration only (see docs/legacy-migration.md).
# Start the old container first: docker start bicapack-postgres
LEGACY_DATABASE_URL="postgresql://bicapack:bicapack_dev@localhost:55432/bicapack?schema=public"
# The raw legacy dump (not the ETL output), for the tables the ETL never carried (ink stock, order pipeline).
LEGACY_RAW_DATABASE_URL="postgresql://bicapack:bicapack_dev@127.0.0.1:55498/bicapack_legacy"
