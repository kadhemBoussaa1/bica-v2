# Production settings, read by deploy/*.sh and docker/docker-compose.prod.yml.
# On the server: copy to .env.production (gitignored), fill in every value,
# chmod 600. Never commit the filled-in copy.
#
# Generate secrets with `openssl rand -hex 32`. Hex needs no quoting; a `$`,
# a quote or a space in a value means different things to compose and bash.

# --- Where it runs -----------------------------------------------------------

# Public host name, no scheme. Web and API share it (nginx routes by path).
# A bare IP serves plain HTTP for a first boot before DNS exists; the
# receiving screen's camera needs HTTPS, so do not give users an IP.
DOMAIN=erp.example.com

# Let's Encrypt account address (expiry warnings). Used by --ssl-init.
LETSENCRYPT_EMAIL=it@example.com

# Only for a test with nginx on other ports; the default is derived from DOMAIN.
# PUBLIC_URL=http://127.0.0.1:8080
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Images ------------------------------------------------------------------

# ghcr.io/<owner>/<repo>, all lowercase. Images: <prefix>-api, -web, -migrate.
IMAGE_PREFIX=ghcr.io/<owner>/bica-v2
# The moving tag CI pushes on every build of main. Pin main-<commit sha> to
# stay on one build; deploy.sh --tag overrides it for one run.
IMAGE_TAG=main

# --- Database ----------------------------------------------------------------

POSTGRES_PASSWORD=

# --- API ---------------------------------------------------------------------

BETTER_AUTH_SECRET=

# Only read by `./deploy/compose.sh run --rm api node dist/seed.js`, on a
# fresh database. 12+ characters.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# Scans and uploads. Rotate the development key before go-live
# (docs/s3-assets-plan.md, step 0) and put only the new one here.
AWS_REGION=us-east-2
AWS_S3_BUCKET=sip-api-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
